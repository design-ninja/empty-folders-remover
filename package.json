{
  "name": "empty-folders-remover",
  "displayName": "Empty Folders Remover",
  "version": "1.6.1",
  "description": "VS Code extension to remove empty folders",
  "icon": "icon.png",
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "pnpm run compile && vsce package",
    "publish": "vsce publish",
    "test": "pnpm run compile && mocha"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "This extension deletes folders and files from the workspace and is disabled in untrusted workspaces."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "empty-folders-remover.removeEmptyFolders",
        "title": "Remove Empty Folders",
        "category": "Empty Folders Remover"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "empty-folders-remover.removeEmptyFolders",
          "when": "explorerResourceIsFolder",
          "group": "7_modification"
        }
      ]
    },
    "configuration": {
      "title": "Empty Folders Remover",
      "properties": {
        "emptyFoldersRemover.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".git",
            ".vscode",
            "node_modules",
            ".npm",
            ".yarn",
            "dist",
            "build",
            ".next",
            ".nuxt",
            "coverage",
            "__pycache__",
            ".pytest_cache",
            ".mypy_cache"
          ],
          "description": "Folder patterns to exclude from scanning. Supports wildcards (*)"
        },
        "emptyFoldersRemover.junkFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".DS_Store",
            "Thumbs.db",
            "desktop.ini"
          ],
          "description": "OS-generated junk files that don't count as folder content. Folders containing only these files are treated as empty, and the files are deleted along with the folder. Supports wildcards (*). Patterns without any literal character (such as \"*\" or \"*.*\") are ignored for safety."
        },
        "emptyFoldersRemover.maxConcurrency": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum number of concurrent file system operations during scanning and removal"
        },
        "emptyFoldersRemover.dryRun": {
          "type": "boolean",
          "default": false,
          "description": "Preview mode: show what would be removed without actually deleting folders"
        },
        "emptyFoldersRemover.showProgress": {
          "type": "boolean",
          "default": true,
          "description": "Show detailed progress information (current folder, percentage, ETA) during the operation"
        },
        "emptyFoldersRemover.useTrash": {
          "type": "boolean",
          "default": true,
          "description": "Move removed folders and junk files to the OS trash instead of deleting them permanently. Disable if deletions fail on file systems without trash support (e.g. some remote workspaces)"
        }
      }
    }
  },
  "keywords": [
    "empty-folders",
    "cleanup",
    "remove-empty",
    "folders",
    "directory",
    "clean",
    "remove",
    "empty",
    "maintenance",
    "organize",
    "cleaner",
    "filesystem",
    "workspace",
    "project-structure",
    "productivity"
  ],
  "author": {
    "name": "lirik"
  },
  "license": "MIT",
  "publisher": "lirik",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/design-ninja/empty-folders-remover.git"
  },
  "bugs": {
    "url": "https://github.com/design-ninja/empty-folders-remover/issues"
  },
  "activationEvents": [],
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.0",
    "@types/vscode": "~1.96.0",
    "@vscode/vsce": "^3.9.2",
    "mocha": "^11.7.6",
    "typescript": "^6.0.3"
  }
}
